# Copy to backend/.env; never put these settings in Flutter.
ENVIRONMENT=development
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Public documentation confirms capabilities; enable only after verifying account access.
VISION_ENABLED=false
FIREBASE_PROJECT_ID=
# Prefer Application Default Credentials in a managed deployment.
# For local use, set an absolute path to a private file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
STREAM_TIMEOUT_SECONDS=180
AUTH_TIMEOUT_SECONDS=10
BODY_TIMEOUT_SECONDS=15
MAX_REQUEST_BYTES=8000000
MAX_IMAGE_BYTES=5000000
MAX_IMAGE_PIXELS=16000000
MAX_HISTORY_CHARACTERS=48000
MAX_OUTPUT_TOKENS=8192
# memory is development-only, single-process, and resets on restart.
# Production startup requires redis and a configured REDIS_URL.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
REQUESTS_PER_MINUTE=10
REQUESTS_PER_DAY=100
MAX_CONCURRENT_REQUESTS=2
